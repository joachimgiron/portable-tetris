#!/bin/sed -Ef
:rng
s/<([01]{64})([01]{64})(\|[01]*)?>/<0t\1s\2ab>/g
:rng_loop

/<0/ {
	s/<0t([01]{23})([01]+)s([01]+)ab>/<1t\1\2s\3a\1\2b\200000000000000000000000>/g
	b rng_xor
}

/<1/ {
	s/<1t([01]+)s([01]+)a([01]+)([01]{18})b>/<2t\1s\2a\3\4b000000000000000000\3>/g
	b rng_xor
}

/<2/ {
	s/<2t([01]+)s([01]+)([01]{5})a([01]+)b>/<3t\4s\2\3a\2\3b00000\2>/g
	b rng_xor
}

/<3/ {
	s/<3t([01]+)s([01]+)a([01]+)b>/<4t\1s\2a\3b\1>/g
	b rng_xor
}

/<4/ {
	s/<4t([01]+)s([01]+)a([01]+)b>/<5t\2s\3a\2b\3>/g
	b rng_add
}

/<5/ {
	s/<5t([01]+)s([01]+)a([01]+)b>/<\1\2|\3>/g
	b rng_end
}

:rng_add

s/a([01]+)b([01]+)/a0,,\1b\2/g
:rng_add_l1
s/a([01]),([01]*),([01]*)([01])b([01]*)([01])/a\1,[\4\6]\2,\3b\5/g
s/([01]),\[00\]/[\10]/g
s/([01]),\[01\]/[\11]/g
s/([01]),\[10\]/[\11]/g
s/([01]),\[11\]/[\12]/g
s/\[00\]/0,0/g
s/\[01\]/0,1/g
s/\[02\]/1,0/g
s/\[10\]/0,1/g
s/\[11\]/1,0/g
s/\[12\]/1,1/g
t rng_add_l1
s/a[01],/a/g
s/,b/b/g
b rng_loop

:rng_xor


s/a([01]+)b([01]+)/a,\1b\2/g
:rng_xor_l1
s/a([01]*),([01])([01]*)b([01])([01]*)/a\1[\2\4],\3b\5/g
s/\[00\]/0/g
s/\[01\]/1/g
s/\[10\]/1/g
s/\[11\]/0/g
t rng_xor_l1
s/,b/b/g
b rng_loop
:rng_end
